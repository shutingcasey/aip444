# OpenRouter — used for ALL LLM generation/chat completion calls (required)
OPENROUTER_API_KEY=your_openrouter_api_key

# Model used for structured extraction + report generation (must support JSON schema structured outputs on OpenRouter)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Tavily — used for the company research web search tool (required)
TAVILY_API_KEY=your_tavily_api_key

# Set to debug for verbose diagnostic logging to stderr (see README)
LOG_LEVEL=info
